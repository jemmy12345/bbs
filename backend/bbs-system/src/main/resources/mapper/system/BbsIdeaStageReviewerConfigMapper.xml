<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BbsIdeaStageReviewerConfigMapper">

    <resultMap id="BbsIdeaStageReviewerConfigResult" type="com.ruoyi.system.domain.BbsIdeaStageReviewerConfig">
        <id property="configId" column="config_id"/>
        <result property="stageCode" column="stage_code"/>
        <result property="stageName" column="stage_name"/>
        <result property="roleKeys" column="role_keys"/>
        <result property="reviewerUserIds" column="reviewer_user_ids"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectIdeaStageReviewerConfigVo">
        select config_id, stage_code, stage_name, role_keys, reviewer_user_ids, status,
               create_by, create_time, update_by, update_time, remark
        from bbs_idea_stage_reviewer_config
    </sql>

    <select id="selectBbsIdeaStageReviewerConfigById" parameterType="Long" resultMap="BbsIdeaStageReviewerConfigResult">
        <include refid="selectIdeaStageReviewerConfigVo"/>
        where config_id = #{configId}
    </select>

    <select id="selectBbsIdeaStageReviewerConfigList" parameterType="com.ruoyi.system.domain.BbsIdeaStageReviewerConfig" resultMap="BbsIdeaStageReviewerConfigResult">
        <include refid="selectIdeaStageReviewerConfigVo"/>
        <where>
            <if test="stageCode != null and stageCode != ''">
                and stage_code = #{stageCode}
            </if>
            <if test="stageName != null and stageName != ''">
                and stage_name like concat('%', #{stageName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by config_id asc
    </select>

    <select id="selectEnabledConfigs" resultMap="BbsIdeaStageReviewerConfigResult">
        <include refid="selectIdeaStageReviewerConfigVo"/>
        where status = '0'
        order by config_id asc
    </select>

    <select id="selectByStageCode" resultMap="BbsIdeaStageReviewerConfigResult">
        <include refid="selectIdeaStageReviewerConfigVo"/>
        where stage_code = #{stageCode}
        limit 1
    </select>

    <insert id="insertBbsIdeaStageReviewerConfig" parameterType="com.ruoyi.system.domain.BbsIdeaStageReviewerConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into bbs_idea_stage_reviewer_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="stageCode != null and stageCode != ''">stage_code,</if>
            <if test="stageName != null and stageName != ''">stage_name,</if>
            role_keys,
            reviewer_user_ids,
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="stageCode != null and stageCode != ''">#{stageCode},</if>
            <if test="stageName != null and stageName != ''">#{stageName},</if>
            #{roleKeys},
            #{reviewerUserIds},
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            now(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBbsIdeaStageReviewerConfig" parameterType="com.ruoyi.system.domain.BbsIdeaStageReviewerConfig">
        update bbs_idea_stage_reviewer_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="stageCode != null and stageCode != ''">stage_code = #{stageCode},</if>
            <if test="stageName != null and stageName != ''">stage_name = #{stageName},</if>
            role_keys = #{roleKeys},
            reviewer_user_ids = #{reviewerUserIds},
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = now(),
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where config_id = #{configId}
    </update>

    <delete id="deleteBbsIdeaStageReviewerConfigByIds">
        delete from bbs_idea_stage_reviewer_config where config_id in
        <foreach item="configId" collection="configIds" open="(" separator="," close=")">
            #{configId}
        </foreach>
    </delete>

</mapper>
