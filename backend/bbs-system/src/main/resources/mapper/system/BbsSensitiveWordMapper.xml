<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BbsSensitiveWordMapper">
    
    <resultMap type="BbsSensitiveWord" id="BbsSensitiveWordResult">
        <id     property="wordId"      column="word_id"      />
        <result property="word"       column="word"        />
        <result property="wordType"   column="word_type"   />
        <result property="status"      column="status"      />
        <result property="createBy"    column="create_by"   />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by"   />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
    </resultMap>
    
    <sql id="selectBbsSensitiveWordVo">
        select word_id, word, word_type, status, create_by, create_time, update_by, update_time, remark 
        from bbs_sensitive_word
    </sql>
    
    <select id="selectBbsSensitiveWordList" parameterType="BbsSensitiveWord" resultMap="BbsSensitiveWordResult">
        <include refid="selectBbsSensitiveWordVo"/>
        <where>
            <if test="word != null and word != ''">
                and word like concat('%', #{word}, '%')
            </if>
            <if test="wordType != null and wordType != ''">
                and word_type = #{wordType}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by word_id desc
    </select>
    
    <select id="selectBbsSensitiveWordById" parameterType="Long" resultMap="BbsSensitiveWordResult">
        <include refid="selectBbsSensitiveWordVo"/>
        where word_id = #{wordId}
    </select>
    
    <select id="selectEnabledSensitiveWordList" resultType="String">
        select word from bbs_sensitive_word where status = '0'
    </select>
    
    <insert id="insertBbsSensitiveWord" parameterType="BbsSensitiveWord" useGeneratedKeys="true" keyProperty="wordId">
        insert into bbs_sensitive_word
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="word != null and word != ''">word,</if>
            <if test="wordType != null">word_type,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="word != null and word != ''">#{word},</if>
            <if test="wordType != null">#{wordType},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    
    <update id="updateBbsSensitiveWord" parameterType="BbsSensitiveWord">
        update bbs_sensitive_word
        <trim prefix="SET" suffixOverrides=",">
            <if test="word != null and word != ''">word = #{word},</if>
            <if test="wordType != null">word_type = #{wordType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where word_id = #{wordId}
    </update>
    
    <delete id="deleteBbsSensitiveWordById" parameterType="Long">
        delete from bbs_sensitive_word where word_id = #{wordId}
    </delete>
    
    <delete id="deleteBbsSensitiveWordByIds" parameterType="String">
        delete from bbs_sensitive_word where word_id in 
        <foreach item="wordId" collection="array" open="(" separator="," close=")">
            #{wordId}
        </foreach>
    </delete>
</mapper>
