<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BbsPostTagMapper">
    
    <insert id="insertBbsPostTag">
        insert into bbs_post_tag (post_id, tag_id)
        values (#{postId}, #{tagId})
    </insert>
    
    <delete id="deleteBbsPostTagByPostId" parameterType="Long">
        delete from bbs_post_tag where post_id = #{postId}
    </delete>
    
    <delete id="deleteBbsPostTagByTagId" parameterType="Long">
        delete from bbs_post_tag where tag_id = #{tagId}
    </delete>

    <select id="selectTagIdsByPostId" parameterType="Long" resultType="Long">
        select tag_id from bbs_post_tag where post_id = #{postId}
    </select>
    
</mapper>
